---
import t from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Pirque%2C%20Regi%C3%B3n%20Metropolitana%2C%20Chile";
const phoneDigits = `+${txt.contacto.telefonoSub.replace(/[^\d]/g, "")}`;
const instagramUser = "francisco_gazitua_mrss";
const instagramWeb = `https://www.instagram.com/${instagramUser}`;
---

<section class="section-card">
  <div class="section-card-inner">
    <h2 class="section-title" style="margin-bottom: 40px; text-align: center;">{txt.contacto.titulo}</h2>

    <div class="card-grid-4">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-card contact-card--link">
        <div class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3F5A73" stroke-width="1.8">
            <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </div>
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;">{txt.contacto.ubicacion}</div>
        <div style="font-size: 11.5px; color: var(--color-secondary); overflow-wrap: anywhere;">{txt.contacto.ubicacionSub}</div>
      </a>

      <a href={`mailto:${txt.contacto.correoSub}`} class="contact-card contact-card--link">
        <div class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3F5A73" stroke-width="1.8">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 6l9 7 9-7"></path>
          </svg>
        </div>
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;">{txt.contacto.correo}</div>
        <div style="font-size: 11.5px; color: var(--color-secondary); overflow-wrap: anywhere;">{txt.contacto.correoSub}</div>
      </a>

      <a href={`tel:${phoneDigits}`} class="contact-card contact-card--link">
        <div class="contact-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3F5A73" stroke-width="1.8">
            <path d="M6.6 10.8a15.9 15.9 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.4c1.2.4 2.6.6 4 .6a1.5 1.5 0 0 1 1.5 1.5v3.4a1.5 1.5 0 0 1-1.6 1.5A17.9 17.9 0 0 1 3.4 4.6 1.5 1.5 0 0 1 4.9 3h3.4A1.5 1.5 0 0 1 9.8 4.5c0 1.4.2 2.8.6 4a1.5 1.5 0 0 1-.4 1.5z"></path>
          </svg>
        </div>
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;">{txt.contacto.telefono}</div>
        <div style="font-size: 11.5px; color: var(--color-secondary); overflow-wrap: anywhere;">{txt.contacto.telefonoSub}</div>
      </a>

      <a href={instagramWeb} target="_blank" rel="noopener noreferrer" class="contact-card contact-card--link" id="instagram-link" data-user={instagramUser}>
        <div class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3F5A73" stroke-width="1.8">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1" fill="#3F5A73" stroke="none"></circle>
          </svg>
        </div>
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;">{txt.contacto.redes}</div>
        <div style="font-size: 11.5px; color: var(--color-secondary); overflow-wrap: anywhere;">{txt.contacto.redesSub}</div>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-card--link {
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  const instagramLink = document.getElementById("instagram-link");
  if (instagramLink) {
    const user = instagramLink.dataset.user;
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (isMobile) {
      instagramLink.addEventListener("click", (e) => {
        e.preventDefault();
        window.location.href = `instagram://user?username=${user}`;
      });
    }
  }
</script>
