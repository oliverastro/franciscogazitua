---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
---

<section class="section" id="contacto">
  <div class="container">
    <h2 class="section-title">{txt.contacto.titulo}</h2>

    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-item">
          <h3 class="contact-label">{txt.contacto.ubicacion}</h3>
          <p class="contact-value">
            <a href="https://maps.google.com" target="_blank" rel="noopener">
              {txt.contacto.verMapa}
            </a>
          </p>
        </div>

        <div class="contact-item">
          <h3 class="contact-label">{txt.contacto.correo}</h3>
          <p class="contact-value">
            <a href="mailto:{txt.contacto.email}">{txt.contacto.email}</a>
          </p>
        </div>

        <div class="contact-item">
          <h3 class="contact-label">{txt.contacto.telefono}</h3>
          <p class="contact-value">
            <a href="tel:{txt.contacto.phone.replace(/[^0-9+]/g, '')}">{txt.contacto.phone}</a>
          </p>
        </div>

        <div class="contact-item">
          <h3 class="contact-label">{txt.contacto.redes}</h3>
          <p class="contact-value">{txt.contacto.social}</p>
        </div>
      </div>

      <div class="contact-map">
        <div class="map-placeholder">
          <span>Mapa</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .contact-value {
    font-size: 1rem;
  }

  .contact-value a {
    transition: color 0.2s;
  }

  .contact-value a:hover {
    color: var(--color-accent);
  }

  .contact-map {
    min-height: 300px;
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-family: var(--font-serif);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
