---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const items = [1, 2, 3, 4, 5];
---

<section class="section" id="publicaciones">
  <div class="container">
    <h2 class="section-title">{txt.publicaciones.titulo}</h2>
    <p class="section-subtitle">{txt.publicaciones.subtitulo}</p>

    <div class="card-grid">
      {items.map((_, i) => (
        <div class="pub-card">
          <div class="pub-cover">
            <span class="pub-placeholder">Publicación {i + 1}</span>
          </div>
          <div class="pub-info">
            <h3 class="pub-title">Título de la publicación</h3>
            <p class="pub-meta">Autor / Editorial</p>
            <span class="pub-year">Año</span>
          </div>
        </div>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "" : "/en"}/publicaciones/`} class="btn">{txt.publicaciones.verTodas}</a>
    </div>
  </div>
</section>

<style>
  .pub-card {
    transition: transform 0.3s;
  }

  .pub-card:hover {
    transform: translateY(-4px);
  }

  .pub-cover {
    aspect-ratio: 3 / 4;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .pub-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .pub-info {
    text-align: center;
  }

  .pub-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .pub-meta {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 2px;
  }

  .pub-year {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .section-action {
    text-align: center;
    margin-top: 48px;
  }
</style>
