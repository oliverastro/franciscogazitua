---
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allPub = await getCollection("publicaciones");
const pubList = allPub
  .filter((p) => p.data.image)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.publicaciones.titulo}</h2>
      <p class="section-subtitle">{txt.publicaciones.desc}</p>
    </div>

    <div class="card-grid-4">
      {pubList.map((p) => (
        <div class="card">
          <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); overflow: hidden; background: var(--color-bg);">
            <img
              src={img(p.data.image)}
              alt={p.data.title}
              style="width: 100%; height: 100%; object-fit: cover;"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <div style="font-size: 13px; font-weight: 600; line-height: 1.35;">{p.data.title}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "/publicaciones/" : "/en/publicaciones/"}`} class="btn-pill">{txt.publicaciones.verTodas} <span class="btn-arrow">→</span></a>
    </div>
  </div>
</section>
