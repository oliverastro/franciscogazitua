---
import t from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = Astro.url.pathname;
const relative = url.startsWith(base) ? url.slice(base.length) || "/" : url;
const isEn = relative.startsWith("/en");
const altLang: Lang = isEn ? "es" : "en";
const altUrl = isEn
  ? base + (relative.replace(/^\/en/, "") || "/")
  : base + "/en/";

const path = isEn ? relative.replace(/^\/en/, "") : relative;
let activeKey: string | null = null;
if (path === "/" || path.startsWith("/index")) activeKey = "inicio";
else if (path.startsWith("/videos")) activeKey = "videos";
else if (path.startsWith("/publicaciones")) activeKey = "publicaciones";
else if (path.startsWith("/biografia")) activeKey = "biografia";

const navItems = [
  { key: "inicio", href: lang === "es" ? `${base}/` : `${base}/en/` },
  { key: "videos", href: lang === "es" ? `${base}/videos/` : `${base}/en/videos/` },
  { key: "publicaciones", href: lang === "es" ? `${base}/publicaciones/` : `${base}/en/publicaciones/` },
  { key: "biografia", href: lang === "es" ? `${base}/biografia/` : `${base}/en/biografia/` },
];
---

<header class="header">
  <div class="header-inner container">
    <a href={lang === "es" ? `${base}/` : `${base}/en/`} class="logo-link">
      <img src={`${base}/images/LogoFranciscoGazitua-500.webp`} alt="Francisco Gazitúa" class="logo-img" />
    </a>

    <div class="header-right">
      <nav class="nav" id="main-nav">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link${activeKey === item.key ? " active" : ""}`}
          >{(txt.nav as any)[item.key]}</a>
        ))}
      </nav>

      <div class="lang-toggle">
        <a href={lang === "es" ? `${base}/` : altUrl} class={`lang-option ${lang === "es" ? "active" : ""}`}>ES</a>
        <span class="lang-sep">/</span>
        <a href={lang === "en" ? `${base}/en/` : altUrl} class={`lang-option ${lang === "en" ? "active" : ""}`}>EN</a>
      </div>

      <button class="menu-toggle" aria-label="Menu" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 28px;
    padding-bottom: 28px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-img {
    height: 24px;
    width: auto;
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .nav-link {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-secondary);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 4px;
    white-space: nowrap;
    transition: color var(--motion-fast), border-color var(--motion-fast);
  }

  .nav-link.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .nav-link:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }

  .lang-option {
    color: var(--color-secondary);
    text-decoration: none;
    cursor: pointer;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
  }

  .lang-option.active {
    color: var(--color-text);
    border-bottom-color: var(--color-muted);
  }

  .lang-sep {
    opacity: 0.5;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: all var(--motion-fast);
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      padding: 20px var(--gutter);
      border-bottom: 1px solid var(--color-border);
      z-index: 99;
    }

    .nav.open {
      display: flex;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupMenu() {
    const menuToggle = document.getElementById("menu-toggle");
    const mainNav = document.getElementById("main-nav");

    menuToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      mainNav?.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      if (!mainNav?.classList.contains("open")) return;
      if (!mainNav.contains(e.target) && e.target !== menuToggle) {
        mainNav.classList.remove("open");
      }
    });
  }

  document.addEventListener("astro:page-load", setupMenu);
</script>
