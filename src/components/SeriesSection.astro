---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="section" id="series">
  <div class="container">
    <h2 class="section-title">{txt.series.titulo}</h2>
    <p class="section-subtitle">{txt.series.subtitulo}</p>

    <div class="card-grid">
      {txt.series.items.map((item) => (
        <div class="series-card">
          <div class="series-image">
            <span class="series-placeholder">{item}</span>
          </div>
          <h3 class="series-name">{item}</h3>
        </div>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "" : "/en"}/series/`} class="btn">{txt.series.verTodas}</a>
    </div>
  </div>
</section>

<style>
  .series-card {
    text-align: center;
    transition: transform 0.3s;
  }

  .series-card:hover {
    transform: translateY(-4px);
  }

  .series-image {
    aspect-ratio: 1;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .series-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .series-name {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .section-action {
    text-align: center;
    margin-top: 48px;
  }
</style>
