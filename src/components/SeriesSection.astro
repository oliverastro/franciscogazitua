---
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const series = txt.series.items;
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.series.titulo}</h2>
      <p class="section-subtitle">{txt.series.subtitulo}</p>
    </div>

    <div class="card-grid-4">
      {series.map((s: any) => (
        <div class="card">
          <div class="card-image">
            <img src={img(s.image)} alt={s.name} loading="lazy" decoding="async" />
          </div>
          <div class="card-label">{s.name}</div>
        </div>
      ))}
    </div>
  </div>
</section>
