---
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allVideos = await getCollection("videos");
const videosList = allVideos.slice(0, 5);
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.videos.titulo}</h2>
      <p class="section-subtitle">{txt.videos.desc}</p>
    </div>

    <div class="videos-grid">
      {videosList.map((v) => (
        <div class="card">
          <a
            href={`${base}${lang === "es" ? "" : "/en"}/videos/`}
            class="video-thumb"
          >
            {v.data.thumbnail ? (
              <img src={img(v.data.thumbnail)} alt={v.data.title} loading="lazy" />
            ) : null}
            <div class="video-thumb-overlay"></div>
            <div class="video-play-btn">
              <div class="video-play-triangle"></div>
            </div>
          </a>
          <div class="card-label card-label--sm">{v.data.title}</div>
        </div>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "/videos/" : "/en/videos/"}`} class="btn-pill">{txt.videos.verTodos}</a>
    </div>
  </div>
</section>
