---
import t from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const slides = txt.hero.slides;
---

<section class="hero-section">
  <div class="container">
    <div class="hero" id="hero-carousel">
      {slides.map((slide: any, i: number) => (
        <div class={`hero-slide ${i === 0 ? "active" : ""}`} data-index={i}>
          <div
            class="hero-slide-bg"
            style={`background-image: url(${slide.image}); background-position: ${slide.bgPosition || "center"};`}
          ></div>
          <div class="hero-slide-gradient"></div>
          <div class="hero-slide-content">
            <div class="hero-badge">{txt.hero.badge}</div>
            <h1 class="hero-title">{slide.title}</h1>
            <p class="hero-desc">{slide.desc}</p>
          </div>
        </div>
      ))}

      <button class="hero-arrow hero-arrow--prev" id="hero-prev" aria-label="Anterior">←</button>
      <button class="hero-arrow hero-arrow--next" id="hero-next" aria-label="Siguiente">→</button>

      <div class="hero-dots" id="hero-dots">
        {slides.map((_: any, i: number) => (
          <button
            class={`hero-dot ${i === 0 ? "active" : ""}`}
            data-index={i}
            aria-label="Ir a slide"
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    margin-top: 8px;
    margin-bottom: 64px;
  }

  .hero {
    position: relative;
    border-radius: var(--radius-section);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-surface);
    min-height: 460px;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    min-height: 460px;
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .hero-slide.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  .hero-slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--color-bg);
  }

  .hero-slide-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 32, 43, 0.72) 0%, rgba(20, 32, 43, 0.45) 45%, rgba(20, 32, 43, 0.05) 75%);
  }

  .hero-slide-content {
    position: relative;
    padding: 64px 140px 64px 100px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    max-width: 560px;
  }

  .hero-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    white-space: nowrap;
  }

  .hero-title {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.15;
    color: var(--color-surface);
    max-width: 420px;
  }

  .hero-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-bg);
    max-width: 420px;
    margin: 0;
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    color: var(--color-text);
    z-index: 2;
  }

  .hero-arrow--prev { left: 20px; }
  .hero-arrow--next { right: 20px; }

  .hero-dots {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 2;
  }

  .hero-dot {
    height: 8px;
    width: 8px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-muted);
    cursor: pointer;
    padding: 0;
    transition: width 0.2s, background 0.2s;
  }

  .hero-dot.active {
    width: 22px;
    background: var(--color-text);
  }

  @media (max-width: 768px) {
    .hero-slide-content {
      padding: 40px 24px;
    }

    .hero-title {
      font-size: 28px;
    }
  }
</style>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll(".hero-slide");
  const dots = document.querySelectorAll(".hero-dot");
  const total = slides.length;

  function goToSlide(index: number) {
    slides[currentSlide]?.classList.remove("active");
    dots[currentSlide]?.classList.remove("active");
    currentSlide = (index + total) % total;
    slides[currentSlide]?.classList.add("active");
    dots[currentSlide]?.classList.add("active");
  }

  document.getElementById("hero-prev")?.addEventListener("click", () => goToSlide(currentSlide - 1));
  document.getElementById("hero-next")?.addEventListener("click", () => goToSlide(currentSlide + 1));

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const idx = parseInt(dot.getAttribute("data-index") || "0");
      goToSlide(idx);
    });
  });

  // Auto-advance every 5s
  setInterval(() => goToSlide(currentSlide + 1), 5000);
</script>
