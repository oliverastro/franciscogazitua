---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const categories = [
  { key: "puentes", image: "" },
  { key: "piedra", image: "" },
  { key: "buques", image: "" },
  { key: "caballos", image: "" },
  { key: "toros", image: "" },
];
---

<section class="section" id="obras">
  <div class="container">
    <h2 class="section-title">{txt.obras.titulo}</h2>
    <p class="section-subtitle">{txt.obras.subtitulo}</p>

    <div class="category-grid">
      {categories.map((cat) => (
        <a href={`${base}${lang === "es" ? "" : "/en"}/obras/${cat.key}/`} class="category-card">
          <div class="category-image">
            <span class="category-placeholder">{cat.key}</span>
          </div>
          <span class="category-label">{txt.obras.categorias[cat.key]}</span>
        </a>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "" : "/en"}/obras/`} class="btn">{txt.obras.verTodas}</a>
    </div>
  </div>
</section>

<style>
  .category-card {
    display: block;
    text-align: center;
    transition: transform 0.3s;
  }

  .category-card:hover {
    transform: translateY(-4px);
  }

  .category-image {
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .category-placeholder {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .category-label {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .section-action {
    text-align: center;
    margin-top: 48px;
  }
</style>
