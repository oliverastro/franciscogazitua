---
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const categories = Object.keys(txt.obras.categorias) as string[];

const slugMap: Record<string, string> = {
  esculturasPiedra: "esculturas-piedra",
  esculturasAcero: "esculturas-acero",
  arteEspacio: "arte-espacio",
  puentes: "puentes",
  piedras: "piedras",
  buques: "buques",
  caballos: "caballos",
  toros: "toros",
  naturaleza: "naturaleza",
  cabezas: "cabezas",
  grabados: "grabados",
  figuraHumana: "figura-humana",
  mobiliario: "mobiliario",
  instrumentos: "instrumentos",
  piedraYAcero: "piedra-y-acero",
  mokomiros: "mokomiros",
  mesas: "mesas",
  avesPlumas: "aves-plumas",
  instrumentosPrimordiales: "instrumentos-primordiales",
  seriesLanzaderas: "series-lanzaderas",
  seriesSauces: "series-sauces",
  seriesLengas: "series-lengas",
  caupolican: "caupolican",
  antartica: "antartica",
};
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.obras.titulo}</h2>
      <p class="section-subtitle">{txt.obras.subtitulo}</p>
    </div>

    <div class="card-grid-4">
      {categories.map((cat) => (
        <a
          href={`${base}${lang === "es" ? "" : "/en"}/obras/${slugMap[cat] || cat}/`}
          class="card"
        >
          <div class="card-image">
            <img
              src={img((txt.obras.images as any)[cat])}
              alt={(txt.obras.categorias as any)[cat]}
              loading="lazy"
            />
          </div>
          <div class="card-label">{(txt.obras.categorias as any)[cat]}</div>
        </a>
      ))}
    </div>
  </div>
</section>
