---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const projects = [1, 2, 3, 4, 5];
---

<section class="section" id="arte-publico">
  <div class="container">
    <h2 class="section-title">{txt.artePublico.titulo}</h2>
    <p class="section-subtitle">{txt.artePublico.subtitulo}</p>

    <div class="card-grid">
      {projects.map((_, i) => (
        <div class="art-card">
          <div class="art-image">
            <span class="art-placeholder">PROYECTO {i + 1}</span>
          </div>
          <div class="art-info">
            <h3 class="art-title">PROYECTO {i + 1}</h3>
          </div>
        </div>
      ))}
    </div>

    <div class="section-action">
      <a href={`${base}${lang === "es" ? "" : "/en"}/arte-publico/`} class="btn">{txt.artePublico.verMas}</a>
    </div>
  </div>
</section>

<style>
  .art-card {
    transition: transform 0.3s;
  }

  .art-card:hover {
    transform: translateY(-4px);
  }

  .art-image {
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .art-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .art-info {
    text-align: center;
  }

  .art-title {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .section-action {
    text-align: center;
    margin-top: 48px;
  }
</style>
