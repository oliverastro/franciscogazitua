---
import t from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.obras.categorias.arteEspacio}</h2>
    </div>

    <div style="columns: 2; column-gap: 40px; text-align: left; max-width: 1000px; margin: 0 auto;">
      <p class="section-text" style="white-space: pre-line;">{txt.catTexts.arteEspacio}</p>
    </div>
  </div>
</section>
