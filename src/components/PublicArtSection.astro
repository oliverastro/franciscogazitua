---
import t from "@/i18n/translations";
import { paragraphs } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.obras.categorias.arteEspacio}</h2>
    </div>

    <div class="text-block" style="margin-bottom: 0;">
      {paragraphs(txt.catTexts.arteEspacio).map((p) => (
        <p class="section-text">{p}</p>
      ))}
    </div>
  </div>
</section>
