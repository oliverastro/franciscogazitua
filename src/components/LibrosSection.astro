---
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allLibros = await getCollection("libros");
const librosList = allLibros.slice(0, 5);
---

<section class="section-card">
  <div class="section-card-inner">
    <div class="section-header">
      <h2 class="section-title">{txt.libros.titulo}</h2>
      <p class="section-subtitle">{txt.libros.desc}</p>
    </div>

    <div class="card-grid-4">
      {librosList.map((l) => (
        <div class="card">
          <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); background: var(--color-bg); display: flex; align-items: center; justify-content: center;">
            {l.data.image ? (
              <img src={img(l.data.image)} alt={l.data.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" decoding="async" />
            ) : (
              <span style="font-size: 0.85rem; color: var(--color-muted); text-align: center; padding: 16px;">{l.data.title}</span>
            )}
          </div>
          <div style="text-align: center;">
            <div style="font-size: 0.95rem; font-weight: 600; margin-bottom: 4px;">{l.data.title}</div>
            <div style="font-size: 0.8rem; color: var(--color-muted); margin-bottom: 2px;">{l.data.author}</div>
            <span style="font-size: 0.75rem; color: var(--color-muted);">{l.data.year}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
