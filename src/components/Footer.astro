---
import t from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const txt = t(lang);
---

<footer class="footer">
  <span>{txt.footer.rights}</span>
  <span class="footer-dot">·</span>
  <span>{txt.footer.dev}</span>
</footer>
