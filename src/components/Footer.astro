---
import t from "../i18n/translations";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const txt = t(lang);
---

<footer class="footer">
  <div class="container">
    <p class="copyright">{txt.footer.copyright}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
    text-align: center;
  }

  .copyright {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
