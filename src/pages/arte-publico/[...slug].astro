---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allProjects = await getCollection("arte-publico");
  const paths = allProjects.map((p) => ({ params: { slug: p.id } }));
  paths.push({ params: { slug: undefined } });
  return paths;
}

const { slug } = Astro.params;
const lang = "es";
const allProjects = await getCollection("arte-publico");
allProjects.sort((a, b) => b.data.year - a.data.year);

const project = slug ? allProjects.find((p) => p.id === slug) : null;
---

<BaseLayout title={project ? project.data.title : "Arte en Espacio Público"} lang={lang}>
  {project ? (
    <section class="section">
      <div class="container">
        <a href="/arte-publico/" class="back-link">&larr; Volver a Arte Público</a>
        <h1 class="section-title">{project.data.title}</h1>
        <div class="project-detail">
          <div class="project-images">
            {project.data.images?.length > 0 ? (
              project.data.images.map((img, i) => (
                <div class="project-image">
                  <img src={img} alt={`${project.data.title} - ${i + 1}`} />
                </div>
              ))
            ) : (
              <div class="project-image placeholder">
                <span>{project.data.title}</span>
              </div>
            )}
          </div>
          <div class="project-info">
            <p class="project-location">
              <strong>Ubicación:</strong> {project.data.location}
            </p>
            <p class="project-year">
              <strong>Año:</strong> {project.data.year}
            </p>
            {project.data.materials && (
              <p class="project-materials">
                <strong>Materiales:</strong> {project.data.materials}
              </p>
            )}
            <p class="project-desc">{project.data.description}</p>
            {project.data.coordinates && (
              <div class="project-map">
                <div class="map-placeholder">
                  Mapa - {project.data.coordinates.lat}, {project.data.coordinates.lng}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Arte en Espacio Público</h1>
        <p class="section-subtitle">Intervenciones y obras del artista en espacios públicos</p>
        <div class="card-grid">
          {allProjects.map((p) => (
            <a href={`/arte-publico/${p.id}/`} class="art-card">
              <div class="art-image">
                {p.data.images?.[0] ? (
                  <img src={p.data.images[0]} alt={p.data.title} />
                ) : (
                  <span class="art-placeholder">{p.data.title}</span>
                )}
              </div>
              <div class="art-info">
                <h3 class="art-title">{p.data.title}</h3>
                <p class="art-location">{p.data.location}</p>
                <span class="art-year">{p.data.year}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 24px;
  }

  .project-detail {
    max-width: 900px;
    margin: 0 auto;
  }

  .project-images {
    margin-bottom: 32px;
  }

  .project-image {
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-image.placeholder span {
    font-family: var(--font-serif);
    color: var(--color-muted);
  }

  .project-info p {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .project-info strong {
    font-weight: 600;
  }

  .project-desc {
    font-size: 1rem;
    margin-top: 16px;
  }

  .map-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    margin-top: 24px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .art-card {
    transition: transform 0.3s;
  }

  .art-card:hover {
    transform: translateY(-4px);
  }

  .art-image {
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .art-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    text-align: center;
    padding: 16px;
  }

  .art-info {
    text-align: center;
  }

  .art-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .art-location {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .art-year {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
