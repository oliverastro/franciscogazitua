---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allLibros = await getCollection("libros");
  const paths = allLibros.map((l) => ({ params: { slug: l.id } }));
  paths.push({ params: { slug: undefined } });
  return paths;
}

const { slug } = Astro.params;
const lang = "es";
const allLibros = await getCollection("libros");
allLibros.sort((a, b) => b.data.year - a.data.year);

const libro = slug ? allLibros.find((l) => l.id === slug) : null;
---

<BaseLayout title={libro ? libro.data.title : "Libros"} lang={lang}>
  {libro ? (
    <section class="section">
      <div class="container">
        <a href="/libros/" class="back-link">&larr; Volver a Libros</a>
        <div class="libro-detail">
          <div class="libro-cover">
            {libro.data.image ? (
              <img src={libro.data.image} alt={libro.data.title} />
            ) : (
              <span class="libro-placeholder">{libro.data.title}</span>
            )}
          </div>
          <div class="libro-info">
            <h1 class="libro-title">{libro.data.title}</h1>
            <p class="libro-author">{libro.data.author}</p>
            <p class="libro-meta">
              {libro.data.publisher}, {libro.data.year}
            </p>
            {libro.data.isbn && <p class="libro-isbn">ISBN: {libro.data.isbn}</p>}
            {libro.data.description && <p class="libro-desc">{libro.data.description}</p>}
            {libro.data.link && (
              <a href={libro.data.link} target="_blank" rel="noopener" class="btn">
                Comprar
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Libros</h1>
        <p class="section-subtitle">Libros publicados sobre la trayectoria y obra del artista</p>
        <div class="card-grid">
          {allLibros.map((l) => (
            <a href={`/libros/${l.id}/`} class="book-card">
              <div class="book-cover">
                {l.data.image ? (
                  <img src={l.data.image} alt={l.data.title} />
                ) : (
                  <span class="book-placeholder">{l.data.title}</span>
                )}
              </div>
              <div class="book-info">
                <h3 class="book-title">{l.data.title}</h3>
                <p class="book-author">{l.data.author}</p>
                <span class="book-year">{l.data.year}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .libro-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 900px;
    margin: 0 auto;
  }

  .libro-cover {
    aspect-ratio: 3 / 4;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .libro-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .libro-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    text-align: center;
    padding: 16px;
  }

  .libro-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    margin-bottom: 8px;
  }

  .libro-author {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .libro-meta {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-bottom: 16px;
  }

  .libro-isbn {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 16px;
  }

  .libro-desc {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
  }

  .book-card {
    transition: transform 0.3s;
  }

  .book-card:hover {
    transform: translateY(-4px);
  }

  .book-cover {
    aspect-ratio: 3 / 4;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    text-align: center;
    padding: 8px;
    font-size: 0.85rem;
  }

  .book-info {
    text-align: center;
  }

  .book-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .book-author {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .book-year {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .libro-detail {
      grid-template-columns: 1fr;
    }
  }
</style>
