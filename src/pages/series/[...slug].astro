---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allSeries = await getCollection("series");
  const paths = allSeries.map((s) => ({ params: { slug: s.id } }));
  paths.push({ params: { slug: undefined } });
  return paths;
}

const { slug } = Astro.params;
const lang = "es";
const allSeries = await getCollection("series");
const series = slug ? allSeries.find((s) => s.id === slug) : null;
---

<BaseLayout title={series ? series.data.title : "Series"} lang={lang}>
  {series ? (
    <section class="section">
      <div class="container">
        <a href="/series/" class="back-link">&larr; Volver a Series</a>
        <h1 class="section-title">{series.data.title}</h1>
        <div class="series-detail">
          {series.data.image && (
            <div class="series-image">
              <img src={series.data.image} alt={series.data.title} />
            </div>
          )}
          <p class="series-description">{series.data.description}</p>
          {(series.data.year_start || series.data.year_end) && (
            <p class="series-years">
              {series.data.year_start}{series.data.year_end ? ` - ${series.data.year_end}` : ""}
            </p>
          )}
          <article class="series-content">
            <slot />
          </article>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Series</h1>
        <p class="section-subtitle">Explora las principales series de obras del artista</p>
        <div class="card-grid">
          {allSeries.map((s) => (
            <a href={`/series/${s.id}/`} class="series-card">
              <div class="series-image">
                {s.data.image ? (
                  <img src={s.data.image} alt={s.data.title} />
                ) : (
                  <span class="series-placeholder">{s.data.title}</span>
                )}
              </div>
              <h3 class="series-name">{s.data.title}</h3>
              <p class="series-desc">{s.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .series-detail {
    max-width: 800px;
    margin: 0 auto;
  }

  .series-image {
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .series-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-description {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .series-years {
    color: var(--color-muted);
    margin-bottom: 24px;
  }

  .series-content {
    line-height: 1.8;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .series-card {
    transition: transform 0.3s;
    display: block;
  }

  .series-card:hover {
    transform: translateY(-4px);
  }

  .series-image {
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .series-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
  }

  .series-name {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .series-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.5;
  }
</style>
