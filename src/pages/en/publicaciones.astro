---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

const lang: Lang = "en";
const txt = t(lang);
const allPub = await getCollection("publicaciones");

const orderBySlug = [
  "palabra-emplazada",
  "libro-francisco-gazitua",
  "puentes-escultoricos",
  "art-science",
  "art-science-vol-ii",
  "apuquinta",
  "casa-tres-volcanes",
  "cuerpo-materia-colectiva",
  "naturaleza-8-miradas",
  "andes-wheel-mokomito",
  "sculpture-home-drawing",
  "catalogo-caballo-barnechea",
  "viaje-al-corazon-de-la-piedra",
  "materia-escultura-poesia",
  "community-partnerships",
  "cordillera-andes",
  "abstrakte-strahlskulptur",
  "academie-royale-belgique",
  "arte-en-su-espacio",
  "artespacio-cristal-2000",
  "buques-acero-catalogo",
  "dialogues-diversity",
  "en-obra-talleres",
  "escultura-chilena-contemporanea",
  "exposicion-familia-artistas",
  "ferroesculturas",
  "francisco-gazitua-esculturas",
  "francisco-gazitua-catalogo",
  "lo-que-somos",
  "metal-design-international",
  "museo-parque-esculturas",
  "pintura-escultura-hoy",
  "simposium-neruda",
  "sculpture-garden",
  "tierra-del-fuego",
  "vsimposium-escultores",
  "el-hombre-marca-su-espacio",
  "escultura-en-el-espacio-publico",
  "la-movida-escultorica-de-marta-colvin",
  "alberto-perez-revisitado",
  "la-escultura-en-chile-raices-y-dependencias",
  "la-copa-llena-felix-maruenda",
  "tierra-del-fuego-2006",
  "de-virginio-arias-a-lily-garafulic",
  "arte-y-ciencia",
  "piedras-de-francisco-gazitua",
  "caballos-de-acero-el-bebedor-de-los-vientos",
  "sauces-de-acero-construccion-funcional",
  "imagen-y-materialidad",
  "buques-de-acero-carta-don-santiago-arias",
  "volver-a-los-andes",
  "el-escultor-como-docente",
  "madera-y-figura-humana",
  "blanco-y-negro",
  "texto-lily-kasner-repaso-artistico-y-vital",
  "escultores-y-mineros",
  "viaje-hacia-rebeca-matte",
  "puentes-catalogo-2012",
  "nicanor-plaza-gazitua-caupolican",
  "buque-esmeralda",
  "gabriela-mistral-y-la-lectura-de-un-escultor",
  "totila-albert-en-sus-talleres",
  "templo-abadia-benedictina",
  "a-bridge-from-sculpture",
  "piedras-e-imagen-en-los-andes-del-sur",
];

const pubList = orderBySlug
  .map((slug) => allPub.find((p) => p.id === slug))
  .filter(Boolean);

const librosList = pubList.filter((p) => p!.data.author === "Libro" || p!.data.author === "Portada");
const pubOnlyList = pubList.filter((p) => p!.data.author !== "Libro" && p!.data.author !== "Portada");
---

<BaseLayout lang={lang} title="Publications">
  <section class="section-card" style="margin-top: 8px;">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{txt.libros.titulo}</h1>
        <p class="section-subtitle">{txt.libros.desc}</p>
      </div>

      <div class="card-grid-4">
        {librosList.map((p) => (
          <div class="card">
            {p!.data.image ? (
              p!.data.pdf ? (
                <a href={img(p!.data.pdf)} target="_blank" rel="noopener noreferrer" class="pub-cover" style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); overflow: hidden; background: var(--color-bg);">
                  <img src={img(p!.data.image)} alt={p!.data.title} style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" decoding="async" />
                  <div class="pub-overlay">
                    <span class="pub-overlay-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
                      {txt.publicaciones.download}
                    </span>
                  </div>
                </a>
              ) : (
                <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); overflow: hidden; background: var(--color-bg);">
                  <img src={img(p!.data.image)} alt={p!.data.title} style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" decoding="async" />
                </div>
              )
            ) : (
              p!.data.pdf ? (
                <a href={img(p!.data.pdf)} target="_blank" rel="noopener noreferrer" class="pub-cover" style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); background: var(--color-bg);">
                  <div class="pub-placeholder">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                    <div class="pub-placeholder-title">{p!.data.title}</div>
                  </div>
                  <div class="pub-overlay">
                    <span class="pub-overlay-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
                      {txt.publicaciones.download}
                    </span>
                  </div>
                </a>
              ) : (
                <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); background: var(--color-bg); display: flex; align-items: center; justify-content: center;">
                  <div class="pub-placeholder">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                    <div class="pub-placeholder-title">{p!.data.title}</div>
                  </div>
                </div>
              )
            )}
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="font-size: 13px; font-weight: 600; line-height: 1.35;">{p!.data.title}</div>
              <div style="font-size: 11.5px; color: var(--color-secondary);">{p!.data.author}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-card">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{txt.publicaciones.titulo}</h1>
        <p class="section-subtitle">{txt.publicaciones.desc}</p>
      </div>

      <div class="card-grid-4">
        {pubOnlyList.map((p) => (
          <div class="card">
            {p!.data.image ? (
              p!.data.pdf ? (
                <a href={img(p!.data.pdf)} target="_blank" rel="noopener noreferrer" class="pub-cover" style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); overflow: hidden; background: var(--color-bg);">
                  <img src={img(p!.data.image)} alt={p!.data.title} style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" decoding="async" />
                  <div class="pub-overlay">
                    <span class="pub-overlay-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
                      {txt.publicaciones.download}
                    </span>
                  </div>
                </a>
              ) : (
                <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); overflow: hidden; background: var(--color-bg);">
                  <img src={img(p!.data.image)} alt={p!.data.title} style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" decoding="async" />
                </div>
              )
            ) : (
              p!.data.pdf ? (
                <a href={img(p!.data.pdf)} target="_blank" rel="noopener noreferrer" class="pub-cover" style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); background: var(--color-bg);">
                  <div class="pub-placeholder">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                    <div class="pub-placeholder-title">{p!.data.title}</div>
                  </div>
                  <div class="pub-overlay">
                    <span class="pub-overlay-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
                      {txt.publicaciones.download}
                    </span>
                  </div>
                </a>
              ) : (
                <div style="aspect-ratio: 3 / 4; border-radius: var(--radius-image); background: var(--color-bg); display: flex; align-items: center; justify-content: center;">
                  <div class="pub-placeholder">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                    <div class="pub-placeholder-title">{p!.data.title}</div>
                  </div>
                </div>
              )
            )}
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="font-size: 13px; font-weight: 600; line-height: 1.35;">{p!.data.title}</div>
              <div style="font-size: 11.5px; color: var(--color-secondary);">{p!.data.author}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection lang={lang} />
</BaseLayout>
