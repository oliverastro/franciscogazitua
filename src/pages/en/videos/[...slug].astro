---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const all = await getCollection("videos");
  return [{ params: { slug: undefined } }, ...all.map((v) => ({ params: { slug: v.id } }))];
}

const { slug } = Astro.params;
const lang = "en";
const all = await getCollection("videos");
const video = slug ? all.find((v) => v.id === slug) : null;
const basePath = "/en";
---

<BaseLayout title={video ? video.data.title : "Videos"} lang={lang}>
  {video ? (
    <section class="section"><div class="container">
      <a href={`${basePath}/videos/`} class="back-link">&larr; Back to Videos</a>
      <h1 class="section-title">{video.data.title}</h1>
      {video.data.description && <p>{video.data.description}</p>}
    </div></section>
  ) : (
    <section class="section"><div class="container">
      <h1 class="section-title">Videos</h1>
      <p class="section-subtitle">Videos about the artist and his work</p>
      <div class="card-grid">
        {all.map((v) => (
          <a href={`${basePath}/videos/${v.id}/`} class="video-card">
            <div class="video-thumb"><span>{v.data.title}</span></div>
            <h3>{v.data.title}</h3>
          </a>
        ))}
      </div>
    </div></section>
  )}
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.85rem; color: var(--color-muted); margin-bottom: 24px; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
  .video-card { transition: transform 0.3s; text-align: center; }
  .video-card:hover { transform: translateY(-4px); }
  .video-thumb { aspect-ratio: 16 / 9; background: var(--color-light); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
</style>
