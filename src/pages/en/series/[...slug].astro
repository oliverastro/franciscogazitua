---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const all = await getCollection("series");
  return [{ params: { slug: undefined } }, ...all.map((s) => ({ params: { slug: s.id } }))];
}

const { slug } = Astro.params;
const lang = "en";
const all = await getCollection("series");
const series = slug ? all.find((s) => s.id === slug) : null;
const basePath = "/en";
---

<BaseLayout title={series ? series.data.title : "Series"} lang={lang}>
  {series ? (
    <section class="section">
      <div class="container">
        <a href={`${basePath}/series/`} class="back-link">&larr; Back to Series</a>
        <h1 class="section-title">{series.data.title}</h1>
        <p class="series-description">{series.data.description}</p>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Series</h1>
        <p class="section-subtitle">Explore the artist's main series</p>
        <div class="card-grid">
          {all.map((s) => (
            <a href={`${basePath}/series/${s.id}/`} class="series-card">
              <div class="series-image">
                <span class="series-placeholder">{s.data.title}</span>
              </div>
              <h3 class="series-name">{s.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.85rem; color: var(--color-muted); margin-bottom: 24px; }
  .series-description { font-size: 1.05rem; line-height: 1.8; max-width: 700px; margin: 0 auto; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .series-card { transition: transform 0.3s; display: block; text-align: center; }
  .series-card:hover { transform: translateY(-4px); }
  .series-image { aspect-ratio: 16 / 9; background: var(--color-light); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
  .series-placeholder { font-family: var(--font-serif); color: var(--color-muted); }
  .series-name { font-size: 1rem; font-weight: 600; }
</style>
