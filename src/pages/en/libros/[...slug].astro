---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const all = await getCollection("libros");
  return [{ params: { slug: undefined } }, ...all.map((l) => ({ params: { slug: l.id } }))];
}

const { slug } = Astro.params;
const lang = "en";
const all = await getCollection("libros");
all.sort((a, b) => b.data.year - a.data.year);
const libro = slug ? all.find((l) => l.id === slug) : null;
const basePath = "/en";
---

<BaseLayout title={libro ? libro.data.title : "Books"} lang={lang}>
  {libro ? (
    <section class="section">
      <div class="container">
        <a href={`${basePath}/libros/`} class="back-link">&larr; Back to Books</a>
        <h1 class="section-title">{libro.data.title}</h1>
        <p>{libro.data.author} &middot; {libro.data.publisher} &middot; {libro.data.year}</p>
        {libro.data.description && <p>{libro.data.description}</p>}
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Books</h1>
        <p class="section-subtitle">Books published about the artist's career and work</p>
        <div class="card-grid">
          {all.map((l) => (
            <a href={`${basePath}/libros/${l.id}/`} class="book-card">
              <div class="book-cover"><span class="book-placeholder">{l.data.title}</span></div>
              <div class="book-info"><h3>{l.data.title}</h3><p>{l.data.author}</p><span>{l.data.year}</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.85rem; color: var(--color-muted); margin-bottom: 24px; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
  .book-card { transition: transform 0.3s; text-align: center; }
  .book-card:hover { transform: translateY(-4px); }
  .book-cover { aspect-ratio: 3 / 4; background: var(--color-light); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
  .book-placeholder { font-family: var(--font-serif); color: var(--color-muted); text-align: center; font-size: 0.85rem; padding: 8px; }
  .book-info h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 4px; }
  .book-info p { font-size: 0.8rem; color: var(--color-muted); }
  .book-info span { font-size: 0.75rem; color: var(--color-muted); }
</style>
