---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const all = await getCollection("publicaciones");
  return [{ params: { slug: undefined } }, ...all.map((p) => ({ params: { slug: p.id } }))];
}

const { slug } = Astro.params;
const lang = "en";
const all = await getCollection("publicaciones");
all.sort((a, b) => b.data.year - a.data.year);
const pub = slug ? all.find((p) => p.id === slug) : null;
const basePath = "/en";
---

<BaseLayout title={pub ? pub.data.title : "Publications"} lang={lang}>
  {pub ? (
    <section class="section"><div class="container">
      <a href={`${basePath}/publicaciones/`} class="back-link">&larr; Back to Publications</a>
      <h1 class="section-title">{pub.data.title}</h1>
      <p>{pub.data.author} &middot; {pub.data.year}</p>
      {pub.data.description && <p>{pub.data.description}</p>}
    </div></section>
  ) : (
    <section class="section"><div class="container">
      <h1 class="section-title">Publications</h1>
      <p class="section-subtitle">Articles, catalogs and publications</p>
      <div class="card-grid">
        {all.map((p) => (
          <a href={`${basePath}/publicaciones/${p.id}/`} class="pub-card">
            <div class="pub-cover"><span>{p.data.title}</span></div>
            <div class="pub-info"><h3>{p.data.title}</h3><p>{p.data.author}</p><span>{p.data.year}</span></div>
          </a>
        ))}
      </div>
    </div></section>
  )}
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.85rem; color: var(--color-muted); margin-bottom: 24px; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
  .pub-card { transition: transform 0.3s; text-align: center; }
  .pub-cover { aspect-ratio: 3 / 4; background: var(--color-light); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
  .pub-info h3 { font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; }
  .pub-info p { font-size: 0.8rem; color: var(--color-muted); }
  .pub-info span { font-size: 0.75rem; color: var(--color-muted); }
</style>
