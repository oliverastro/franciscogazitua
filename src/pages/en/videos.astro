---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { translateVideoTitle } from "@/i18n/workNames";
import { getCollection } from "astro:content";

const lang: Lang = "en";
const txt = t(lang);
const allVideos = (await getCollection("videos")).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout lang={lang} title="Videos">
  <section class="section-card" style="margin-top: 8px;">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{txt.videos.titulo}</h1>
        <p class="section-subtitle">{txt.videos.desc}</p>
      </div>

      <div class="card-grid-4" id="videos-grid">
        {allVideos.map((v, i) => {
          const title = translateVideoTitle(v.data.title, lang);
          const thumb = v.data.thumbnail ? img(v.data.thumbnail) : "";
          return (
            <div class="card" data-index={i}>
              <a
                class="video-thumb"
                href={v.data.url || undefined}
                target={v.data.url ? "_blank" : undefined}
                rel={v.data.url ? "noopener noreferrer" : undefined}
                aria-label={v.data.url ? `Open ${title} on YouTube` : undefined}
              >
                {thumb ? (
                  <img src={thumb} alt={title} loading="lazy" decoding="async" />
                ) : (
                  <div style="width: 100%; height: 100%; border: 1.5px dashed var(--color-muted); border-radius: var(--radius-image); background: var(--color-bg); display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px;">
                    <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10px; color: var(--color-secondary);">video thumbnail<br/>— {title} —</span>
                  </div>
                )}
                {thumb && (
                  <>
                    <div class="video-thumb-overlay"></div>
                    <div class="video-play-btn">
                      <div class="video-play-triangle"></div>
                    </div>
                  </>
                )}
              </a>
              <div class="card-label card-label--sm">{title}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <ContactSection lang={lang} />
</BaseLayout>
