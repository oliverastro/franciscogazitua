---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

const lang: Lang = "en";
const txt = t(lang);
const allVideos = (await getCollection("videos")).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout lang={lang} title="Videos">
  <section class="section-card" style="margin-top: 8px;">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{txt.videos.titulo}</h1>
        <p class="section-subtitle">{txt.videos.desc}</p>
      </div>

      <div class="card-grid-4" id="videos-grid">
        {allVideos.map((v, i) => {
          const thumb = v.data.thumbnail ? img(v.data.thumbnail) : "";
          return (
            <div class="card" data-index={i} data-url={v.data.url || ""}>
              <div class="video-thumb" data-video-index={i}>
                {thumb ? (
                  <img src={thumb} alt={v.data.title} loading="lazy" decoding="async" />
                ) : (
                  <div style="width: 100%; height: 100%; border: 1.5px dashed var(--color-muted); border-radius: var(--radius-image); background: var(--color-bg); display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px;">
                    <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10px; color: var(--color-secondary);">video thumbnail<br/>— {v.data.title} —</span>
                  </div>
                )}
                {thumb && (
                  <>
                    <div class="video-thumb-overlay"></div>
                    <div class="video-play-btn">
                      <div class="video-play-triangle"></div>
                    </div>
                  </>
                )}
              </div>
              <div class="card-label card-label--sm">{v.data.title}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <ContactSection lang={lang} />
</BaseLayout>

<script>
  function setupVideos() {
    document.querySelectorAll(".video-thumb").forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const card = thumb.closest(".card");
        const url = card?.getAttribute("data-url");
        if (!url) return;

        const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
        if (!match) return;

        const videoId = match[1];
        const container = thumb as HTMLElement;
        container.innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1" title="Video" style="width: 100%; height: 100%; border: 0; position: absolute; inset: 0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="true"></iframe>`;
        container.style.position = "relative";
      });
    });
  }

  document.addEventListener("astro:page-load", setupVideos);
</script>
