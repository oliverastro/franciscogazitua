---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const obras = await getCollection("obras");
  return obras.map((entry) => ({
    params: { category: entry.id },
  }));
}

const lang: Lang = "en";
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { category } = Astro.params;

const entry = await getEntry("obras", category!);
if (!entry) {
  return Astro.redirect(`${base}/en/obras/`);
}

const catTitle = (txt.obras.categorias as any)[entry.data.category] || entry.data.title;
const catText = (txt.catTexts as any)[entry.data.category] || "";
const works = (entry.data.works || []).map((w: any) => ({ ...w, image: img(w.image) }));
const galleryItems = works.map((w: any, i: number) => {
  if (i < 4) {
    return {
      ...w,
      attrs: { style: `background-image: url('${encodeURI(w.image)}')` },
    };
  }
  return {
    ...w,
    attrs: { "data-bg": `url("${encodeURI(w.image)}")` },
  };
});
---

<BaseLayout lang={lang} title={catTitle}>
  <section class="section-card" style="margin-bottom: 0;">
    <div class="breadcrumb">
      <a href={`${base}/en/obras/`}>{txt.common.volverObras}</a>
    </div>
  </section>

  <section class="section-card">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{catTitle}</h1>
      </div>

      {catText && (
        <div class={`cat-description${entry.data.category === "arteEspacio" || entry.data.category === "puentes" ? " cat-description--columns" : entry.data.category === "toros" || entry.data.category === "naturaleza" ? " cat-description--narrow" : ""}`}>
          <p class="section-text">{catText}</p>
        </div>
      )}

<div class="gallery-grid" id="gallery">
        {galleryItems.map((g: any, i: number) => (
          <div class="gallery-item" data-index={i}>
            <div class="gallery-item-image" {...g.attrs}></div>
            <div class="gallery-item-name">{g.name}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div id="lightbox">
    <div class="lightbox-overlay" id="lightbox-overlay">
      <div class="lightbox-content">
        <div class="lightbox-image" id="lightbox-image"></div>
        <div class="lightbox-info">
          <span id="lightbox-name"></span>
          <span id="lightbox-counter"></span>
        </div>
      </div>
      <button class="lightbox-nav lightbox-nav--prev" id="lightbox-prev">←</button>
      <button class="lightbox-nav lightbox-nav--next" id="lightbox-next">→</button>
      <button class="lightbox-close" id="lightbox-close">×</button>
    </div>
  </div>

  <ContactSection lang={lang} />
</BaseLayout>

<script define:vars={{ works }}>
  function setupCategory() {
    const worksData = works;
    let currentIndex = null;
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightbox-image");

    function openLightbox(i) {
      currentIndex = i;
      updateLightbox();
      lightbox.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      currentIndex = null;
      lightbox.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    function updateLightbox() {
      if (currentIndex === null) return;
      const w = worksData[currentIndex];
      lightboxImage.classList.add("is-transitioning");
      setTimeout(() => {
        lightboxImage.style.backgroundImage = `url("${encodeURI(w.image)}")`;
        document.getElementById("lightbox-name").textContent = w.name;
        document.getElementById("lightbox-counter").textContent = `${currentIndex + 1}/${worksData.length}`;
        lightboxImage.classList.remove("is-transitioning");
      }, 200);
    }

    function prevImage() {
      if (currentIndex === null) return;
      currentIndex = (currentIndex - 1 + worksData.length) % worksData.length;
      updateLightbox();
    }

    function nextImage() {
      if (currentIndex === null) return;
      currentIndex = (currentIndex + 1) % worksData.length;
      updateLightbox();
    }

    document.querySelectorAll(".gallery-item").forEach((item) => {
      item.addEventListener("click", () => {
        openLightbox(parseInt(item.dataset.index));
      });
    });

    document.getElementById("lightbox-close")?.addEventListener("click", closeLightbox);
    document.getElementById("lightbox-overlay")?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeLightbox();
    });
    document.getElementById("lightbox-prev")?.addEventListener("click", (e) => { e.stopPropagation(); prevImage(); });
    document.getElementById("lightbox-next")?.addEventListener("click", (e) => { e.stopPropagation(); nextImage(); });

    document.addEventListener("keydown", (e) => {
      if (currentIndex === null) return;
      if (e.key === "ArrowRight") nextImage();
      else if (e.key === "ArrowLeft") prevImage();
      else if (e.key === "Escape") closeLightbox();
    });
  }

  document.addEventListener("astro:page-load", setupCategory);
</script>

<script>
  function setupGalleryLazyLoad() {
    const lazyImages = document.querySelectorAll(".gallery-item-image[data-bg]");
    if (!lazyImages.length) return;

    const vh = window.innerHeight;
    lazyImages.forEach((el) => {
      if (el.getBoundingClientRect().top < vh) {
        el.style.backgroundImage = el.dataset.bg;
        el.removeAttribute("data-bg");
      }
    });

    const imageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target;
          el.style.backgroundImage = el.dataset.bg;
          el.removeAttribute("data-bg");
          imageObserver.unobserve(el);
        }
      });
    }, { rootMargin: "200px" });
    lazyImages.forEach((img) => {
      if (img.hasAttribute("data-bg")) imageObserver.observe(img);
    });
  }

  document.addEventListener("astro:page-load", setupGalleryLazyLoad);
</script>
