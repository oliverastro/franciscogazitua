---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import t from "@/i18n/translations";
import { img } from "@/i18n/translations";
import type { Lang } from "@/i18n/translations";
import { getCollection } from "astro:content";

const lang: Lang = "en";
const txt = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allObras = await getCollection("obras");
---

<BaseLayout lang={lang} title="Works">
  <section class="section-card" style="margin-top: 8px;">
    <div class="section-card-inner">
      <div class="section-header">
        <h1 class="section-title section-title--page">{txt.obras.titulo}</h1>
        <p class="section-subtitle">{txt.obras.desc}</p>
      </div>

      <div class="card-grid-4">
        {allObras.map((o) => (
          <a
            href={`${base}${lang === "es" ? "" : "/en"}/obras/${o.id}/`}
            class="card"
          >
            <div class="card-image">
              <img
                src={img((txt.obras.images as any)[o.data.category])}
                alt={(txt.obras.categorias as any)[o.data.category] || o.data.title}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-label">{(txt.obras.categorias as any)[o.data.category] || o.data.title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactSection lang={lang} />
</BaseLayout>
