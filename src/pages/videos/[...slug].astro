---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allVideos = await getCollection("videos");
  const paths = allVideos.map((v) => ({ params: { slug: v.id } }));
  paths.push({ params: { slug: undefined } });
  return paths;
}

const { slug } = Astro.params;
const lang = "es";
const allVideos = await getCollection("videos");
const video = slug ? allVideos.find((v) => v.id === slug) : null;
---

<BaseLayout title={video ? video.data.title : "Videos"} lang={lang}>
  {video ? (
    <section class="section">
      <div class="container">
        <a href="/videos/" class="back-link">&larr; Volver a Videos</a>
        <h1 class="section-title">{video.data.title}</h1>
        <div class="video-detail">
          <div class="video-embed">
            <div class="video-placeholder">YouTube/Vimeo Embed</div>
          </div>
          {video.data.duration && <span class="video-duration">{video.data.duration}</span>}
          {video.data.description && <p class="video-desc">{video.data.description}</p>}
          {video.data.date && <p class="video-date">{video.data.date}</p>}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="container">
        <h1 class="section-title">Videos</h1>
        <p class="section-subtitle">Videos del artista y su trabajo</p>
        <div class="card-grid">
          {allVideos.map((v) => (
            <a href={`/videos/${v.id}/`} class="video-card">
              <div class="video-thumb">
                {v.data.thumbnail ? (
                  <img src={v.data.thumbnail} alt={v.data.title} />
                ) : (
                  <span class="video-placeholder">{v.data.title}</span>
                )}
                {v.data.duration && <span class="video-duration-badge">{v.data.duration}</span>}
              </div>
              <div class="video-info">
                <h3 class="video-title">{v.data.title}</h3>
                {v.data.date && <span class="video-date">{v.data.date}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 24px;
  }

  .video-detail {
    max-width: 800px;
    margin: 0 auto;
  }

  .video-embed {
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .video-duration {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 16px;
  }

  .video-desc {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 8px;
  }

  .video-date {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .video-card {
    transition: transform 0.3s;
  }

  .video-card:hover {
    transform: translateY(-4px);
  }

  .video-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    text-align: center;
    padding: 16px;
  }

  .video-duration-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 2px 8px;
    font-size: 0.75rem;
    border-radius: 2px;
  }

  .video-info {
    text-align: center;
  }

  .video-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .video-date {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
</style>
