---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const obras = await getCollection("obras");
  const categories = [...new Set(obras.map((o) => o.data.category))];
  const paths = [];

  for (const cat of categories) {
    paths.push({ params: { slug: cat } });
  }
  for (const obra of obras) {
    paths.push({ params: { slug: `${obra.data.category}/${obra.id}` } });
  }
  paths.push({ params: { slug: undefined } });

  return paths;
}

const { slug } = Astro.params;
const lang = "es";
const allObras = await getCollection("obras");
const categories = [...new Set(allObras.map((o) => o.data.category))];

let pageTitle = "Obras";
let obras = allObras;
let category = null;

if (slug === undefined) {
  pageTitle = "Todas las Obras";
} else if (categories.includes(slug)) {
  category = slug;
  obras = allObras.filter((o) => o.data.category === slug);
  pageTitle = slug.charAt(0).toUpperCase() + slug.slice(1);
} else {
  const slugParts = slug.split("/");
  const obraId = slugParts[slugParts.length - 1];
  const obra = allObras.find((o) => o.id === obraId);
  if (obra) {
    const [catPart, ...rest] = slugParts;
    return Astro.redirect(`/obras/${obra.data.category}/${obra.id}`);
  }
}
---

<BaseLayout title={pageTitle} lang={lang}>
  <section class="section">
    <div class="container">
      <h1 class="section-title">{pageTitle}</h1>
      <p class="section-subtitle">Explora las obras del artista</p>

      <div class="category-tabs">
        <a href="/obras/" class={`tab ${!category ? "active" : ""}`}>Todas</a>
        {categories.map((cat) => (
          <a href={`/obras/${cat}/`} class={`tab ${category === cat ? "active" : ""}`}>
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </a>
        ))}
      </div>

      <div class="card-grid">
        {obras.map((obra) => (
          <a href={`/obras/${obra.data.category}/${obra.id}/`} class="obra-card">
            <div class="obra-image">
              {obra.data.image ? (
                <img src={obra.data.image} alt={obra.data.title} />
              ) : (
                <span class="obra-placeholder">{obra.data.category}</span>
              )}
            </div>
            <div class="obra-info">
              <h3 class="obra-title">{obra.data.title}</h3>
              {obra.data.year && <span class="obra-year">{obra.data.year}</span>}
              {obra.data.materials && <p class="obra-materials">{obra.data.materials}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .tab {
    padding: 8px 20px;
    border: 1px solid var(--color-border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
  }

  .tab:hover,
  .tab.active {
    border-color: var(--color-text);
    background: var(--color-text);
    color: white;
  }

  .obra-card {
    transition: transform 0.3s;
  }

  .obra-card:hover {
    transform: translateY(-4px);
  }

  .obra-image {
    aspect-ratio: 4 / 3;
    background: var(--color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .obra-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .obra-placeholder {
    font-family: var(--font-serif);
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .obra-info {
    text-align: center;
  }

  .obra-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .obra-year {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .obra-materials {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
</style>
