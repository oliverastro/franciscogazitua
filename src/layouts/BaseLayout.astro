---
import "../styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title?: string;
  lang?: "es" | "en";
}

const { title = "Francisco Gazitúa", lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Francisco Gazitúa</title>
    <meta name="description" content="Francisco Gazitúa - Escultor chileno, Premio Nacional de Artes Plásticas" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
